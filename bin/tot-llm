#!/usr/bin/env bash
# tot-llm — manual on/off control for the local Ollama server used by
# TranslateOnTheGo. Nothing here ever runs at boot; you start it when you
# want it and stop it when you're done.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/translateonthego"
CONFIG="$CONFIG_DIR/config"
UNIT="ollama"

# Pull OLLAMA_* / MODEL settings from the same config the keybind uses, so
# `tot-llm pull` and Super+H can never disagree about which model is meant.
if [[ -f "$CONFIG" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG"
fi

MODEL="${OLLAMA_MODEL:-gemma4:e4b-it-qat}"
HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
[[ "$HOST" =~ ^https?:// ]] || HOST="http://$HOST"
HOST="${HOST%/}"
MODELS_DIR="${OLLAMA_MODELS:-${XDG_DATA_HOME:-$HOME/.local/share}/ollama/models}"

export OLLAMA_HOST OLLAMA_MODELS

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
say()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[err]\033[0m %s\n' "$*" >&2; exit 1; }

command -v ollama >/dev/null 2>&1 \
  || die "ollama is not installed. Run: sudo pacman -S --needed ollama ollama-cuda"

is_up() { curl -sf --connect-timeout 1 --max-time 3 "$HOST/api/version" >/dev/null 2>&1; }

# The Arch package also ships a *system* ollama.service that stores models in
# root-owned /var/lib/ollama. If it ever gets enabled, models appear to vanish.
check_system_unit() {
  if systemctl is-enabled ollama.service >/dev/null 2>&1; then
    warn "The SYSTEM ollama.service is enabled — it will autostart at boot and"
    warn "uses /var/lib/ollama for models, not your user directory."
    warn "Disable it with: sudo systemctl disable --now ollama.service"
  fi
}

wait_up() {
  local tries=40
  while (( tries-- )); do
    is_up && return 0
    sleep 0.5
  done
  return 1
}

cmd_start() {
  check_system_unit
  if is_up; then
    say "Already running at $HOST"
    return 0
  fi
  say "Starting ollama (user service)…"
  systemctl --user start "$UNIT"
  wait_up || die "Server did not come up. Logs: tot-llm logs"
  say "Up at $HOST — models in $MODELS_DIR"
  gpu_line
}

cmd_stop() {
  if ! systemctl --user is-active --quiet "$UNIT" && ! is_up; then
    say "Already stopped."
    return 0
  fi
  say "Stopping ollama — model unloads from VRAM and the daemon exits."
  systemctl --user stop "$UNIT"
  say "Stopped. Nothing is resident."
}

cmd_restart() { cmd_stop; cmd_start; }

# Free VRAM but leave the server up, for when you'll be back in a minute.
cmd_unload() {
  is_up || die "Server isn't running."
  local loaded
  loaded="$(curl -sf "$HOST/api/ps" | jq -r '.models[]?.name' 2>/dev/null || true)"
  if [[ -z "$loaded" ]]; then
    say "Nothing is loaded."
    return 0
  fi
  while read -r m; do
    [[ -z "$m" ]] && continue
    say "Unloading $m"
    curl -sf -X POST "$HOST/api/generate" \
      -H 'Content-Type: application/json' \
      -d "$(jq -n --arg model "$m" '{model:$model, keep_alive:0}')" >/dev/null
  done <<< "$loaded"
  say "VRAM released. Server still up — 'tot-llm stop' to shut it down fully."
}

gpu_line() {
  command -v nvidia-smi >/dev/null 2>&1 || return 0
  local used total
  read -r used total < <(nvidia-smi --query-gpu=memory.used,memory.total \
    --format=csv,noheader,nounits 2>/dev/null | tr ',' ' ') || return 0
  printf '    GPU: %s / %s MiB used\n' "$used" "$total"
}

cmd_status() {
  check_system_unit
  bold "service"
  printf '    user unit : %s\n' "$(systemctl --user is-active "$UNIT" 2>/dev/null || echo inactive)"
  printf '    autostart : %s\n' "$(systemctl --user is-enabled "$UNIT" 2>/dev/null || echo disabled)"
  printf '    endpoint  : %s (%s)\n' "$HOST" "$(is_up && echo reachable || echo unreachable)"
  printf '    models    : %s\n' "$MODELS_DIR"
  if [[ -d "$MODELS_DIR" ]]; then
    printf '    disk      : %s\n' "$(du -sh "$MODELS_DIR" 2>/dev/null | cut -f1)"
  fi
  printf '    configured: %s\n' "$MODEL"
  echo
  if is_up; then
    bold "loaded in VRAM"
    local ps
    ps="$(curl -sf "$HOST/api/ps" | jq -r '.models[]? | "    \(.name)  \(.size_vram/1073741824*100|round/100)GiB VRAM  expires \(.expires_at)"' 2>/dev/null || true)"
    [[ -n "$ps" ]] && echo "$ps" || echo "    (nothing — server idle)"
    echo
  fi
  gpu_line
}

cmd_pull() {
  local m="${1:-$MODEL}"
  cmd_start
  say "Pulling $m into $MODELS_DIR"
  ollama pull "$m"
}

cmd_list() {
  cmd_start >/dev/null
  ollama list
}

cmd_rm() {
  local m="${1:?usage: tot-llm rm <model>}"
  cmd_start >/dev/null
  ollama rm "$m"
}

cmd_run() {
  cmd_start >/dev/null
  ollama run "${1:-$MODEL}"
}

cmd_test() {
  cmd_start
  local m="${1:-$MODEL}"
  local sample='The quick brown fox jump over a lazy dogs.'
  local proj tmp t0 t1 ms out
  proj="$(dirname "$(dirname "$(readlink -f "$0")")")"
  tmp="$(mktemp -t tot-test.XXXXXX)"
  trap 'rm -f "$tmp"' RETURN

  say "Round-trip test against $m…"
  printf '%s' "$sample" > "$tmp"
  t0=$(( $(date +%s%N) / 1000000 ))
  out="$(OLLAMA_MODEL="$m" "$proj/lib/ollama.sh" Correct "$tmp")" || return 1
  t1=$(( $(date +%s%N) / 1000000 ))
  ms=$(( t1 - t0 ))

  echo
  printf '  in  : %s\n' "$sample"
  printf '  out : %s\n' "$out"
  printf '  time: %d.%02ds\n\n' "$(( ms / 1000 ))" "$(( ms % 1000 / 10 ))"
  gpu_line
}

cmd_logs() { journalctl --user -u "$UNIT" -f; }

usage() {
  cat <<'EOF'
tot-llm — on-demand local model server for TranslateOnTheGo

  start            Start the server (never runs at boot)
  stop             Stop it — unloads the model and exits the daemon
  restart          stop + start
  unload           Free VRAM but leave the server running
  status           Service state, loaded models, VRAM, disk usage
  test [model]     Time a real round-trip through the provider script

  pull [model]     Download a model (defaults to the configured one)
  list             Installed models
  rm <model>       Delete a model
  run [model]      Interactive chat, for poking at it directly
  logs             Follow the server log

Model and endpoint come from ~/.config/translateonthego/config.
EOF
}

case "${1:-status}" in
  start)   shift; cmd_start "$@" ;;
  stop)    shift; cmd_stop "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  unload)  shift; cmd_unload "$@" ;;
  status)  shift; cmd_status "$@" ;;
  test)    shift; cmd_test "$@" ;;
  pull)    shift; cmd_pull "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  rm)      shift; cmd_rm "$@" ;;
  run)     shift; cmd_run "$@" ;;
  logs)    shift; cmd_logs "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
