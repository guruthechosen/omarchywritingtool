#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/translateonthego"
CONFIG="$CONFIG_DIR/config"
if [[ -f "$CONFIG" ]]; then
  # shellcheck disable=SC1090
  if ! source "$CONFIG" 2>/tmp/tot-config-err; then
    notify-send -u critical "TranslateOnTheGo" \
      "Config parse error in $CONFIG: $(cat /tmp/tot-config-err)"
    exit 1
  fi
fi

MODEL="${MODEL:-gemini-3.5-flash-lite}"
TARGET_LANG="${TARGET_LANG:-Korean}"
PROVIDER="${PROVIDER:-gemini}"

FALLBACK_ENABLED="${FALLBACK_ENABLED:-true}"

# Set by any provider that talks to a server on this machine — those are the
# ones worth falling back to Gemini for when their server isn't running.
IS_LOCAL=0

case "$PROVIDER" in
  gemini)
    if [[ -z "${GEMINI_API_KEY:-}" ]]; then
      notify-send -u critical "TranslateOnTheGo" "GEMINI_API_KEY not set. Export it in your shell env or config."
      exit 1
    fi
    PROVIDER_SCRIPT="lib/gemini.sh"
    ;;
  ollama)
    PROVIDER_SCRIPT="lib/ollama.sh"
    IS_LOCAL=1
    ;;
  lmstudio)
    PROVIDER_SCRIPT="lib/lmstudio.sh"
    IS_LOCAL=1
    ;;
  *)
    notify-send -u critical "TranslateOnTheGo" "Unknown PROVIDER '$PROVIDER' in config. Use 'gemini', 'ollama', or 'lmstudio'."
    exit 1
    ;;
esac

SCRIPT_PATH="$(readlink -f "$0")"
BIN_DIR="$(dirname "$SCRIPT_PATH")"
PROJ_DIR="$(dirname "$BIN_DIR")"

# Ask for text/plain explicitly first. Some apps (LibreOffice, browsers)
# advertise text/html ahead of plain text, and wl-paste's default pick would
# hand back markup instead of the words the user selected.
grab() {
  local args=("$@")
  local out
  out="$(wl-paste "${args[@]}" -t text/plain --no-newline 2>/dev/null || true)"
  [[ -z "$out" ]] && out="$(wl-paste "${args[@]}" --no-newline 2>/dev/null || true)"
  printf '%s' "$out"
}

TEXT="$(grab -p)"
SOURCE="selection"

if [[ -z "$TEXT" ]]; then
  # Nothing owns PRIMARY. Falling back to the clipboard is usually right, but
  # the clipboard may hold something copied hours ago — say so rather than
  # silently translating the wrong text.
  TEXT="$(grab)"
  SOURCE="clipboard"
fi

if [[ -z "$TEXT" ]]; then
  notify-send "TranslateOnTheGo" \
    "Nothing to work on — no active selection and the clipboard is empty."
  exit 0
fi

# Pick whichever dmenu-style picker this desktop actually ships. Omarchy 4
# dropped walker for its own shell menu, so hard-coding one launcher breaks the
# tool on a distro upgrade. Each branch must print the chosen line on stdout.
pick_action() {
  local opts
  opts="$(printf 'Translate\nProofread\nCorrect\n')"

  if command -v walker >/dev/null 2>&1; then
    printf '%s\n' "$opts" | walker -d -p 'Writing Tools:' -X -e 2>/dev/null
  elif command -v omarchy-menu-select >/dev/null 2>&1; then
    printf '%s\n' "$opts" | omarchy-menu-select 'Writing Tools' 2>/dev/null
  elif command -v fuzzel >/dev/null 2>&1; then
    printf '%s\n' "$opts" | fuzzel --dmenu --prompt 'Writing Tools: ' 2>/dev/null
  elif command -v wofi >/dev/null 2>&1; then
    printf '%s\n' "$opts" | wofi --dmenu --prompt 'Writing Tools' 2>/dev/null
  elif command -v rofi >/dev/null 2>&1; then
    printf '%s\n' "$opts" | rofi -dmenu -p 'Writing Tools' 2>/dev/null
  else
    notify-send -u critical "TranslateOnTheGo" \
      "No menu program found. Install one of: walker, fuzzel, wofi, rofi."
    return 1
  fi
}

ACTION="$(pick_action || true)"
# Trim whitespace — some pickers return the line with a trailing newline or
# padding, and the provider scripts match the action name exactly.
ACTION="${ACTION#"${ACTION%%[![:space:]]*}"}"
ACTION="${ACTION%"${ACTION##*[![:space:]]}"}"
[[ -z "$ACTION" ]] && exit 0

ORIG_FILE="$(mktemp -t tot-orig.XXXXXX)"
RESULT_FILE="$(mktemp -t tot-result.XXXXXX)"
trap 'rm -f "$ORIG_FILE" "$RESULT_FILE"' EXIT

printf '%s' "$TEXT" > "$ORIG_FILE"

export GEMINI_API_KEY MODEL TARGET_LANG
export LMSTUDIO_URL LMSTUDIO_MODEL
export OLLAMA_HOST OLLAMA_URL OLLAMA_MODEL OLLAMA_KEEP_ALIVE OLLAMA_NUM_CTX OLLAMA_NO_THINK
ERR_FILE="$(mktemp -t tot-err.XXXXXX)"
trap 'rm -f "$ORIG_FILE" "$RESULT_FILE" "$ERR_FILE"' EXIT

run_provider() {
  local script="$1"
  : > "$RESULT_FILE"
  : > "$ERR_FILE"
  "$PROJ_DIR/$script" "$ACTION" "$ORIG_FILE" > "$RESULT_FILE" 2> "$ERR_FILE"
}

if ! run_provider "$PROVIDER_SCRIPT"; then
  ERR="$(cat "$ERR_FILE" 2>/dev/null || true)"
  if [[ "$IS_LOCAL" == "1" && "$FALLBACK_ENABLED" == "true" && -n "${GEMINI_API_KEY:-}" ]]; then
    notify-send "TranslateOnTheGo" "Local model unavailable ($PROVIDER) — falling back to Gemini."
    if ! run_provider "lib/gemini.sh"; then
      ERR2="$(cat "$ERR_FILE" 2>/dev/null || true)"
      notify-send -u critical "TranslateOnTheGo" "Both providers failed. $PROVIDER: ${ERR:-unknown}. Gemini: ${ERR2:-unknown}"
      exit 1
    fi
  else
    notify-send -u critical "TranslateOnTheGo" "$PROVIDER error: ${ERR:-unknown}"
    exit 1
  fi
fi

if [[ ! -s "$RESULT_FILE" ]]; then
  notify-send "TranslateOnTheGo" "Empty response from provider."
  exit 1
fi

rm -f "$ERR_FILE"
trap - EXIT
exec python3 "$PROJ_DIR/bin/tot-review.py" \
  --action "$ACTION" \
  --source "$SOURCE" \
  --original-file "$ORIG_FILE" \
  --result-file "$RESULT_FILE"
